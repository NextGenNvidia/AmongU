# ==============================================================================
# AmongU Frontend Environment Configuration
# ==============================================================================
# NOTE: All variables below are STRICTLY REQUIRED.
# There are ZERO fallbacks or default values in the codebase.
# ==============================================================================

# Backend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Firebase Web Client Configuration (For Google Sign-In)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Razorpay Client Key ID (For checkout popup)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
