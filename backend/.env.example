# ==============================================================================
# AmongU Backend Environment Configuration
# ==============================================================================
# NOTE: All variables below are STRICTLY REQUIRED.
# There are ZERO fallbacks or default values in the codebase.
# The server will halt startup immediately if any key is missing or malformed.
# ==============================================================================

# Server Network & Runtime
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/amongu?retryWrites=true&w=majority

# Event Settings
REGISTRATION_FEE_INR=55
REGISTRATION_OPEN=true

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Admin Authorization (comma-separated authorized admin emails)
ADMIN_EMAILS=admin@kiet.edu,organizer@kiet.edu
